{
  "name": "statement-import",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "node",
        "preset": "jest-expo/node",
        "testMatch": [
          "<rootDir>/test/**/*.node.test.ts"
        ],
        "setupFiles": [
          "<rootDir>/test/support/silence-logs.ts"
        ]
      },
      {
        "displayName": "ui",
        "preset": "jest-expo/ios",
        "testMatch": [
          "<rootDir>/test/**/*.ui.test.tsx"
        ],
        "setupFiles": [
          "<rootDir>/test/support/silence-logs.ts"
        ]
      }
    ]
  }
}
